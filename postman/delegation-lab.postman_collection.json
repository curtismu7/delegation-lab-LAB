    {
      "name": "Consent and tool gate",
      "description": "Mint the delegated token (consent), then call the tool gate with it. The token object is chained into the tool call via the DELEGATED_TOKEN collection variable. Runs accumulate in /api/runs; flip a directory group or reset to change outcomes.",
      "item": [
        {
          "name": "Consent: mint a delegated token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().token).to.have.property('act');",
                  "pm.collectionVariables.set('DELEGATED_TOKEN', JSON.stringify(pm.response.json().token));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/consent",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "consent"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Tool call without a token (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.expect(pm.response.code).to.eql(400);",
                  "pm.expect(pm.response.json().error).to.eql('token_required');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
