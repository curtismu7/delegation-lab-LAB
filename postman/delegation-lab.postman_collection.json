              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Tool call with the delegated token (PERMIT, Standard ceiling)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Pre-request */",
                  "const t = pm.collectionVariables.get('DELEGATED_TOKEN');",
                  "pm.collectionVariables.set('DELEGATED_TOKEN', t);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().decision).to.eql('PERMIT');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"token\": {{DELEGATED_TOKEN}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/tool",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "tool"
              ]
            },
            "description": ""
